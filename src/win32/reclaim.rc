#include <windows.h>
#include "resource.h"

IDI_RECLAIM_ICON ICON "../../assets/reclaim.ico"
IDR_MAIN_MANIFEST RT_MANIFEST "reclaim.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reclaim Open Source"
            VALUE "FileDescription", "Reclaim — Storage Analyzer, Safe Cache Cleaner & Quarantine Vault"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "Reclaim"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Reclaim.exe"
            VALUE "ProductName", "Reclaim"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
